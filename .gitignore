# Working records (plans, issues, status, decisions-in-progress) stay out of
# the public repository. Configuration and distributable tooling under
# .claude/ is tracked; records live locally or in the maintainer's private
# notes.
/.claude/*
!/.claude/tools/
!/.claude/rules/
!/.claude/templates/
!/.claude/hooks/
!/.claude/commands/
!/.claude/agents/
!/.claude/skills/
!/.claude/settings.json
/.claude/settings.local.json

# Rust build output
/target/
